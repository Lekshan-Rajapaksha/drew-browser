---
import { colour } from "../data/press";
import { base } from "../data/site";
import { REPO } from "../data/release";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ardia for Linux</title>
    <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48" />
    <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
  </head>
  <body style={`background:${colour("Paper").toLowerCase()};color:${colour("Ink").toLowerCase()};font:16px/1.5 system-ui,sans-serif;padding:48px 24px;max-width:640px;margin:0 auto;`}>
    <h1>Ardia for Linux</h1>
    <p>The Linux port is currently in active development.</p>
    <p>Target formats: AppImage and Debian (.deb) packages for Ubuntu 22.04+ / Fedora 38+.</p>
    <p>
      <a href={REPO} style="color:#0358f7;font-weight:600;">Track progress on GitHub &rarr;</a>
    </p>
  </body>
</html>

